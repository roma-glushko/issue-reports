{
  "name": "Tyk Test Endpoints",
  "slug": "tyk-test-endpoints",
  "api_id": "tyk-test-endpoints",
  "use_keyless": false,
  "global_rate_limit": {
    "rate": 0,
    "per": 0
  },
  "proxy": {
    "listen_path": "/httpbin",
    "target_url": "http://localhost:8080",
    "strip_listen_path": true
  },
  "active": true,
  "auth": {
    "auth_header_name": "Authorization",
    "use_custom_auth": true,
    "use_cookie": true,
    "cookie_name": "session"
  },
  "use_go_plugin_auth": true,
  "custom_middleware": {
    "pre": [
      {
        "disabled": false,
        "name": "InjectHeaders",
        "path": "/opt/tyk-gateway/middleware/inject_headers.so",
        "require_session": false,
        "raw_body_only": false
      }
    ],
    "post": null,
    "response": null,
    "driver": "goplugin",
    "id_extractor": {
      "disabled": false,
      "extract_from": "",
      "extract_with": "",
      "extractor_config": null
    }
  }
}